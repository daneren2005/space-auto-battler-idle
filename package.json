{
	"name": "space-auto-battler-idle",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"serve": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"type-check": "tsc --noEmit",
		"lint": "cross-env NODE_ENV=production oxlint .",
		"lint:fix": "cross-env NODE_ENV=production oxlint --fix .",
		"start": "npm run dev",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"benchmark:stress": "node --experimental-transform-types --import ./scripts/worker-threads/register-worker-alias.mjs scripts/stress-benchmark.ts",
		"report:balance": "node --import ./scripts/register-alias.mjs scripts/level-balance.ts",
		"report:ai-run": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/ai-run.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"@daneren2005/shared-memory-ecs": "^1.8.1",
		"@daneren2005/shared-memory-objects": "^1.6.0",
		"@daneren2005/shared-memory-physics": "^1.7.2",
		"phaser": "^3.90.0",
		"pretty-bytes": "^7.1.3",
		"rand-seed": "^3.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^26.6.2",
		"cross-env": "^10.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"oxlint": "1.85.0",
		"oxlint-tsgolint": "^7.0.2002",
		"typescript": "~7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.1.11"
	}
}
